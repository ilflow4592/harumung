{
  "expo": {
    "name": "하루멍",
    "slug": "harumung",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "harumung",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "kr.harumung.app",
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "강아지 사진과 영상을 촬영하기 위해 카메라를 사용합니다.",
        "NSMicrophoneUsageDescription": "영상 촬영 시 소리를 녹음하기 위해 마이크를 사용합니다.",
        "NSPhotoLibraryUsageDescription": "강아지 등록 사진을 갤러리에서 고르기 위해 사용합니다.",
        "UIBackgroundModes": [
          "fetch"
        ]
      }
    },
    "android": {
      "package": "kr.harumung.app",
      "adaptiveIcon": {
        "backgroundColor": "#D7F3EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}